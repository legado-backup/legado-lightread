    "test:sync-engine": "node --experimental-strip-types --test scripts/test-sync-engine.mjs",
    "test:sync-settings": "node --experimental-strip-types --test scripts/test-sync-settings.mjs",
    "test:sync-account": "node --experimental-strip-types --test scripts/test-sync-account.mjs",
